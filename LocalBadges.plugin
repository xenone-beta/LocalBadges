    def _mgr_refresh(self):
        try:
            if self._sheet_alive() and self._sheet_page in ("manager", "home"):
                self._show_page(self._sheet_page)
        except Exception:
            pass

    @staticmethod
    def _parse_since(data):
        items = data.get("supporters") if isinstance(data, dict) else data
        out = {}
        if not isinstance(items, list):
            return out
        for it in items[:SUPPORTERS_MAX_ITEMS]:
            try:
                if isinstance(it, dict) and it.get("since"):
                    uid, since = int(it.get("id")), int(it.get("since"))
                    if 0 < uid < 2 ** 52 and since > 0:
                        out[uid] = since
            except Exception:
                continue
        return out

    @staticmethod
    def _parse_supporters(data):
        items = data.get("supporters") if isinstance(data, dict) else data
        if not isinstance(items, list):
            return None
        best = {}
        for it in items[:SUPPORTERS_MAX_ITEMS]:
            try:
                if isinstance(it, dict):
                    uid, until = int(it.get("id")), int(it.get("until") or 0)
                else:
                    uid, until = int(it), 0
            except Exception:
                continue
            if not (0 < uid < 2 ** 52) or until < 0:
                continue
            if uid in best and best[uid] == 0:
                continue
            if uid not in best or until == 0 or until > best[uid]:
                best[uid] = until
        return sorted(best.items())

    def _load_supporters(self):
        import json
        try:
            raw = json.loads(self.get_setting("supporters_cache", "{}") or "{}")
            pairs = raw.get("list") if isinstance(raw, dict) else None
            lst = self._parse_supporters([{"id": x[0], "until": x[1]} for x in pairs]) if isinstance(pairs, list) else []
            self._sup_list = list(lst or [])
            since = raw.get("since") if isinstance(raw, dict) else None
            self._sup_since = {int(k): int(v) for k, v in since.items()} if isinstance(since, dict) else {}
        except Exception:
            self._sup_list = []

    def _fetch_supporters(self, manual=False):
        import urllib.request
        import json
        if self._sup_busy:
            return
        self._sup_busy = True
        try:
            if not SUPPORTERS_URL.startswith("https://"):
                return
            req = urllib.request.Request(SUPPORTERS_URL)
            req.add_header("User-Agent", "LocalBadges/{}".format(__version__))
            resp = urllib.request.urlopen(req, timeout=8)
            body = resp.read(SUPPORTERS_MAX_BYTES + 1)
            if len(body) > SUPPORTERS_MAX_BYTES:
                raise ValueError("список слишком большой")
            parsed = json.loads(body.decode("utf-8"))
            lst = self._parse_supporters(parsed)
            if lst is None:
                raise ValueError("неверный формат")
            since = self._parse_since(parsed)
            changed = lst != list(self._sup_list) or since != self._sup_since
            self._sup_list = lst
            self._sup_since = since
            if changed:
                self._save_setting("supporters_cache", json.dumps({"ts": int(time.time()),
                                                                   "list": [[a, b] for a, b in lst],
                                                                   "since": {str(k): v for k, v in since.items()}}))
                run_on_ui_thread(self._after_supporters)
            if manual:
                self._toast("Список Supporter обновлён" if changed else "Список Supporter актуален", "success")
        except Exception as e:
            self._log(f"supporters: {e}")
            if manual:
                self._toast("Не удалось обновить список: {}".format(e), "error")
        finally:
            self._sup_busy = False

    def _after_supporters(self):
        try:
            self._rebuild_badges()
            self._refresh_ui()
            if self._sheet_alive() and self._sheet_page in ("supporter", "home", "manager"):
                self._show_page(self._sheet_page)
        except Exception as e:
            self._log(f"after supporters: {e}")

    def _start_supporters_loop(self):
        def _loop():
            if self._stop_evt.wait(25):
                return
            last_fetch = 0.0
            while True:
                try:
                    if time.time() - last_fetch >= SUPPORTERS_REFRESH_SEC:
                        last_fetch = time.time()
                        self._fetch_supporters()
                    now = time.time()
                    live = frozenset(u for u, t in self._sup_list if not t or t >= now)
                    expired = any(t <= now for t in list(self._timed_active.values()))
                    if live != self._sup_active or expired:
                        run_on_ui_thread(self._after_supporters)
                except Exception:
                    pass
                if self._stop_evt.wait(300):
                    return

        threading.Thread(target=_loop, name="LocalBadgesSupporters", daemon=True).start()

    def _manual_supporters_refresh(self):
        self._toast("Обновляю список…")
        threading.Thread(target=lambda: self._fetch_supporters(manual=True),
                         name="LocalBadgesSupportersManual", daemon=True).start()

    def _my_supporter(self):
        uid = self._cur_uid()
        now = time.time()
        for u, until in self._sup_list:
            if u == uid and (not until or until >= now):
                return True, until
        return False, 0

    def _open_support_bot(self, start="plugin"):
        try:
            from org.telegram.messenger.browser import Browser
            from android.net import Uri
            ctx = self._activity()
            if ctx:
                url = SUPPORT_BOT_URL + ("?start=" + start if start else "")
                Browser.openUrl(ctx, Uri.parse(url), True, True)
        except Exception as e:
            self._log(f"open bot: {e}")

    def _set_hidden(self, value):
        self._save_setting("badges_hidden", bool(value))
        self._rebuild_badges()
        if not value:
            for key in list(self._plans):
                try:
                    space, oid = self._split_key(key)
                    self._touch(space, oid)
                except Exception:
                    pass
        self._refresh_ui()
        self._toast("Все бейджи скрыты" if value else "Бейджи снова показываются")

    def _start_update_check(self):
        def _loop():

            if self._stop_evt.wait(20):
                return
            while True:
                try:
                    self._check_for_updates()
                except Exception:
                    pass
                if self._stop_evt.wait(7200):
                    return

        threading.Thread(target=_loop, name="LocalBadgesUpdate", daemon=True).start()

    def _fetch_latest_version(self):
        import urllib.request
        import json
        req = urllib.request.Request(GITHUB_META_URL)
        req.add_header('User-Agent', 'LocalBadges/{}'.format(__version__))
        response = urllib.request.urlopen(req, timeout=5)
        data = json.loads(response.read().decode('utf-8'))
        return str(data.get("version", "0.0.0"))

    def _check_for_updates(self, manual=False):
        try:
            latest_version = self._fetch_latest_version()
        except Exception as e:
            if manual:
                self._toast("Не удалось проверить обновления: {}".format(e), "error")
            return

        if _ver_tuple(latest_version) > _ver_tuple(__version__):
            run_on_ui_thread(lambda: BulletinHelper.show_with_button(
                "Доступна новая версия v{}! Обновить?".format(latest_version),
                0, "Обновить",
                lambda: self._download_update(latest_version),
                None, 10000
            ))
        elif manual:
            self._toast("У вас последняя версия: v{}".format(__version__), "success")

    def _manual_update_check(self):
        self._toast("Проверяю обновления…")
        threading.Thread(target=lambda: self._check_for_updates(manual=True),
                         name="LocalBadgesManualUpdate", daemon=True).start()

    def _download_update(self, version):
        import urllib.request

        try:
            req = urllib.request.Request(GITHUB_RAW_URL)
            req.add_header('User-Agent', 'LocalBadges/{}'.format(__version__))
            response = urllib.request.urlopen(req, timeout=10)
            new_content = response.read().decode('utf-8')

            with open(__file__, 'w', encoding='utf-8') as f:
                f.write(new_content)

            run_on_ui_thread(lambda: BulletinHelper.show_success(
                "Плагин обновлён до версии v{}! Перезагрузи его.".format(version)
            ))
        except Exception as e:
            run_on_ui_thread(lambda: BulletinHelper.show_error(
                "Ошибка обновления: {}".format(str(e))
            ))


class _Interceptor(MethodHook):

    def __init__(self, plugin, space):
        self.m = plugin
        self.space = space

    def after_hooked_method(self, param):
        try:
            m = self.m

            if threading.get_ident() != m._ui_ident or not m._plans:
                return
            obj = param.getResult()
            if obj is None:
                return
            now = time.monotonic()
            if now - m._acct_ts > 3.0:
                m._acct_ts = now
                m._check_account()
            if m._lock.acquire(False):
                try:
                    m._apply_badges(obj, self.space)
                finally:
                    m._lock.release()
        except Exception:
            pass
