SUBTYPES = _SubtypeDict({
    "user": ("Пользователь", "верифицирован", SPACE_USER),
    "bot": ("Бот", "верифицирован", SPACE_USER),
    "channel": ("Канал", "верифицирован", SPACE_CHAT),
    "group": ("Группа", "верифицирована", SPACE_CHAT),
})

_TME_RE = re.compile(r"^(?:https?://)?(?:www\.)?(?:t|telegram)\.(?:me|dog)/(.+)$", re.I)
_TME_SKIP = ("joinchat", "addstickers", "addemoji", "share", "proxy", "socks", "setlanguage", "addtheme", "boost",
             "iv", "login", "confirmphone", "addlist", "m", "invoice", "giftcode", "contact", "c")


def _norm_target(token):
    t = str(token or "").strip().strip("<>()[]\"'")
    if not t:
        return ""
    m = re.match(r"^tg://resolve\?(?:.*&)?domain=([A-Za-z0-9_]{3,})", t, re.I)
    if m:
        return "@" + m.group(1)
    m = re.match(r"^tg://user\?(?:.*&)?id=(\d+)", t, re.I)
    if m:
        return m.group(1)
    m = _TME_RE.match(t)
    if not m:
        return t
    path = m.group(1).split("?")[0].split("#")[0].strip("/")
    parts = path.split("/")
    head = parts[0]
    if head.lower() == "c" and len(parts) > 1 and parts[1].isdigit():
        return "-100" + parts[1]
    if not head or head.startswith("+") or head.lower() in _TME_SKIP:
        return ""
    if re.fullmatch(r"[A-Za-z0-9_]{3,}", head):
        return "@" + head
    return ""


_MISSING = object()


def _verify_text(subtype, org=None):
    noun, verb, _ = SUBTYPES.get(subtype, SUBTYPES["user"])
    if org:
        return _T("%s %s организацией «%s»") % (noun, verb, org)
    return "%s %s" % (noun, verb)


def _icon_for(vtype, custom_id):
    if custom_id:
        try:
            return int(custom_id)
        except Exception:
            pass
    return ICON_MAJOR if vtype == "major" else ICON_HOLD


def _ver_tuple(value):
    try:
        return tuple(int(x) for x in re.findall(r"\d+", str(value)))
    except Exception:
        return (0,)


try:
    from java import dynamic_proxy, jlong, jarray, jfloat, jclass
    from android.view import View as _View, Gravity as _Gravity
    from android.widget import (LinearLayout as _LL, FrameLayout as _FL, ScrollView as _SV,
                                TextView as _TV, EditText as _ET, HorizontalScrollView as _HSV)
    from android.graphics import Typeface as _Typeface
    from android.graphics.drawable import (GradientDrawable as _GD, RippleDrawable as _RD,
                                           ColorDrawable as _CD, LayerDrawable as _LayerD, Drawable as _Drawable)
    from android.content.res import ColorStateList as _CSL
    from android.text import InputType as _InputType

    class _Click(dynamic_proxy(_View.OnClickListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onClick(self, v):
            try:
                self.fn(v)
            except Exception as e:
                try:
                    log("[LocalBadges] click error: {}".format(e))
                except Exception:
                    pass

    class _Focus(dynamic_proxy(_View.OnFocusChangeListener)):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onFocusChange(self, v, has_focus):
            try:
                if not has_focus:
                    self.fn(v)
            except Exception as e:
                log("[LocalBadges] focus error: {}".format(e))

    class _Watcher(dynamic_proxy(jclass("android.text.TextWatcher"))):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def beforeTextChanged(self, s, a, b, c):
            pass

        def onTextChanged(self, s, a, b, c):
            pass

        def afterTextChanged(self, s):
            try:
                self.fn(str(s))
            except Exception:
                pass

    class _Dismiss(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def onDismiss(self, dialog):
            try:
                self.fn()
            except Exception:
                pass

    class _Run(dynamic_proxy(jclass("java.lang.Runnable"))):
        def __init__(self, fn):
            super().__init__()
            self.fn = fn

        def run(self):
            try:
                self.fn()
            except Exception:
                pass

    _UI_OK = True
except Exception:
    _UI_OK = False
    _Click = None

    def jlong(x):
        return int(x)

