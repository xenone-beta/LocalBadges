            root.addView(self._button(ctx, pal, _T("Купить навсегда за 50 ⭐"), lambda: self._open_support_bot("plugin")),
                         _lp(-1, -2, None, (0, 0, 0, 8)))
        root.addView(self._button(ctx, pal, _T("Подарить Supporter"), lambda: self._open_support_bot("gift"), "tonal"),
                     _lp(-1, -2, None, (0, 0, 0, 8)))
        root.addView(self._button(ctx, pal, _T("Ввести промокод"), lambda: self._open_support_bot("redeem"), "tonal"),
                     _lp(-1, -2, None, (0, 0, 0, 8)))
        root.addView(self._button(ctx, pal, _T("История в боте"), lambda: self._open_support_bot("history"), "tonal"),
                     _lp(-1, -2, None, (0, 0, 0, 8)))
        root.addView(self._button(ctx, pal, _T("Обновить список"), self._manual_supporters_refresh, "tonal"),
                     _lp(-1, -2, None, (0, 0, 0, 14)))
        sec, card = self._section(ctx, pal, _T("Как это работает"))
        card.addView(self._row(ctx, pal, _T("Бейдж видят все"), _T("У всех, у кого установлен LocalBadges")))
        card.addView(self._divider(ctx, pal), _lp(-1, 1, None, (14, 0, 14, 0)))
        card.addView(self._row(ctx, pal, _T("Появляется сам"), _T("Список обновляется раз в час, после оплаты можно нажать «Обновить список»")))
        card.addView(self._divider(ctx, pal), _lp(-1, 1, None, (14, 0, 14, 0)))
        card.addView(self._row(ctx, pal, _T("Подарки и промокоды"), _T("Кнопки выше открывают бота: подарок другу, ввод промокода, история покупок")))
        root.addView(sec, _lp(-1, -2))

    def _page_updates(self, ctx, pal, root):
        sec, card = self._section(ctx, pal, _T("Версия"))
        card.addView(self._row(ctx, pal, _T("Текущая версия"), "v%s" % __version__))
        card.addView(self._divider(ctx, pal), _lp(-1, 1, None, (14, 0, 14, 0)))
        card.addView(self._row(ctx, pal, _T("Автопроверка"), _T("Раз в 2 часа")))
        root.addView(sec, _lp(-1, -2, None, (0, 0, 0, 14)))
        root.addView(self._button(ctx, pal, _T("Проверить обновления сейчас"), lambda: self._manual_update_check(), "tonal"),
                     _lp(-1, -2))

    def _page_about(self, ctx, pal, root):
        sec, card = self._section(ctx, pal, _T("Плагин"))
        card.addView(self._row(ctx, pal, "LocalBadges", _T("Версия %s") % __version__))
        card.addView(self._divider(ctx, pal), _lp(-1, 1, None, (14, 0, 14, 0)))
        card.addView(self._row(ctx, pal, _T("Автор"), "@oystrix"))
        card.addView(self._divider(ctx, pal), _lp(-1, 1, None, (14, 0, 14, 0)))
        card.addView(self._row(ctx, pal, _T("Канал"), "@HysteriaPlugins", lambda: self._open_channel(), chevron=True))
        root.addView(sec, _lp(-1, -2, None, (0, 0, 0, 14)))
        sec, card = self._section(ctx, pal, _T("Возможности"))
        feats = (
            (_T("Локальные бейджи для себя"), _T("Major, Hold, галочка, кастомный эмодзи")),
            (_T("Бейджи для других"), _T("Пользователи, боты, каналы и группы")),
            (_T("Встроенные бейджи"), _T("Для официальных лиц и каналов")),
            (_T("Пометка Scam"), _T("Для пользователей с жалобами")),
