_LANG = "ru"
LANG_CHOICES = (("auto", None), ("ru", "Русский"), ("uk", "Українська"), ("en", "English"))


def _T(text):
    table = _I18N.get(_LANG)
    if table is None:
        return text
    return table.get(text, text)


def _detect_lang():
    code = ""
    try:
        from org.telegram.messenger import LocaleController
        info = LocaleController.getInstance().getCurrentLocaleInfo()
        code = str(info.getLangCode() or "")
    except Exception:
        code = ""
    if not code:
        try:
            from java.util import Locale
            code = str(Locale.getDefault().getLanguage() or "")
        except Exception:
            code = ""
    code = code.lower().replace("_", "-").split("-")[0]
    if code == "uk":
        return "uk"
    if code in ("ru", "be", "kk"):
        return "ru"
    return "en"


def _set_lang(pref):
    global _LANG
    code = pref if pref in ("ru", "uk", "en") else _detect_lang()
    _LANG = code
    return code


class _LabelDict(dict):
    def get(self, key, default=None):
        value = dict.get(self, key, default)
        return _T(value) if isinstance(value, str) else value

    def __getitem__(self, key):
        return _T(dict.__getitem__(self, key))


class _SubtypeDict(dict):
    @staticmethod
    def _tr(value):
        if isinstance(value, tuple) and len(value) == 3 and isinstance(value[0], str):
            return (_T(value[0]), _T(value[1]), value[2])
        return value

    def get(self, key, default=None):
        return self._tr(dict.get(self, key, default))

    def __getitem__(self, key):
        return self._tr(dict.__getitem__(self, key))



